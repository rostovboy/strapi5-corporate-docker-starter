{
  "kind": "collectionType",
  "collectionName": "news",
  "info": {
    "singularName": "new",
    "pluralName": "news",
    "displayName": "Новости"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "longtitle": {
      "type": "string"
    },
    "published": {
      "type": "boolean",
      "default": true
    },
    "publishDate": {
      "type": "datetime"
    },
    "introtext": {
      "type": "richtext"
    },
    "content": {
      "type": "richtext"
    },
    "thumb": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images"
      ]
    },
    "noThumb": {
      "type": "boolean",
      "default": false
    },
    "photoGallery": {
      "type": "boolean",
      "default": false
    },
    "photoCarousel": {
      "type": "boolean",
      "default": false
    },
    "seo": {
      "type": "component",
      "component": "shared.seo-data",
      "repeatable": false
    },
    "searchable": {
      "type": "boolean",
      "default": true
    }
  }
}
