{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Продукция"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "longtitle": {
      "type": "string"
    },
    "published": {
      "type": "boolean",
      "default": true
    },
    "article": {
      "type": "string",
      "unique": true
    },
    "brand": {
      "type": "string"
    },
    "price": {
      "type": "decimal"
    },
    "oldPrice": {
      "type": "decimal"
    },
    "introtext": {
      "type": "richtext"
    },
    "content": {
      "type": "richtext"
    },
    "new": {
      "type": "boolean"
    },
    "hit": {
      "type": "boolean",
      "default": false
    },
    "inPrice": {
      "type": "boolean",
      "default": true
    },
    "barcode": {
      "type": "string",
      "unique": true
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images"
      ]
    },
    "tds": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "seo": {
      "type": "component",
      "component": "shared.seo-data",
      "repeatable": false
    },
    "searchable": {
      "type": "boolean",
      "default": true
    }
  }
}
